# Variables de la API
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/chatbotsoporte?schema=public"

HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=*

# Cambie este secreto en producción (mínimo 32 caracteres)
JWT_SECRET=tu-clave-secreta-jwt-de-32-caracteres-o-mas
CRYPTO_SECRET=tu-clave-secreta-aes-256-gcm-32-caracteres-aqui
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=14

# agy = CLI real de Antigravity · mock = respuestas simuladas para desarrollo
AGENT_MODE=mock
AGY_BIN=agy.exe
AGY_MODEL=gemini-3.8-flash-medium
AGY_FALLBACK_MODELS=
AGY_EFFORT=low
AGY_TIMEOUT_MS=240000
AGENT_WORKSPACE=../agent
AGENT_EXTRA_DIRS=
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_MESSAGE_CHARS=4000
