DATABASE_URL="postgresql://usuario:contraseña@127.0.0.1:5432/chatbotsoporte?schema=public"

HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=*

# Cambia este secreto en cualquier entorno real (mínimo 32 caracteres)
JWT_SECRET=tu-clave-secreta-jwt-de-32-caracteres-o-mas
CRYPTO_SECRET=tu-clave-secreta-aes-256-gcm-32-caracteres-aqui
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=14

# Agente Antigravity CLI: "agy" usa el CLI real, "mock" simula respuestas sin cuota
AGENT_MODE=mock
AGY_BIN=agy.exe
AGY_MODEL=gemini-3.8-flash-medium
AGY_FALLBACK_MODELS=
AGY_TIMEOUT_MS=900000
AGENT_WORKSPACE=../agent

# Código de SismaSalud para consulta de solo lectura (opcional)
AGENT_EXTRA_DIRS=
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_MESSAGE_CHARS=4000

# Conexión solo lectura a base de datos de SismaSalud (SQL Server)
SISMA_DB_ENABLE_RO=false
SISMA_DB_SERVER=127.0.0.1
SISMA_DB_PORT=1433
SISMA_DB_DATABASE=SismaSalud_Testing
SISMA_DB_USER=usuario_sql
SISMA_DB_PASSWORD=tu_contrasena_sql_aqui
SISMA_DB_TIMEOUT_MS=60000
